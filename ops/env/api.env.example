APP_ENV=production
PROVIDER_APPROVAL_MODE=false
DATABASE_URL=postgres:///z_games?host=/var/run/postgresql
JWT_SECRET=replace-with-at-least-32-random-characters
HOST=127.0.0.1
PORT=3002
SUPER_ADMIN_PHONE=09123456789
PAYAMAK_PANEL_USERNAME=
PAYAMAK_PANEL_API_KEY=
PAYAMAK_PANEL_BODY_ID=
CREDENTIALS_KEY=replace-with-a-base64-encoded-32-byte-key
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=false
FRONTEND_URL=https://z-games.store
API_PUBLIC_URL=https://api.z-games.store
UPLOAD_DIR=/var/lib/z-games/uploads
RETURN_DIR=/var/lib/z-games/returns
TRUSTED_PROXIES=127.0.0.1,::1
