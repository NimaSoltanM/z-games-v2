# Required in every environment: development, test, or production.
APP_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/z_games
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3002
SUPER_ADMIN_PHONE=09123456789

# Payamak Panel shared service-line template. Development can leave these empty
# and will receive dev_code instead. All three are required in production.
PAYAMAK_PANEL_USERNAME=
PAYAMAK_PANEL_API_KEY=
PAYAMAK_PANEL_BODY_ID=

# Base64-encoded 32-byte AES key. Back it up separately from the database.
# Valid development-only example (32 zero bytes). Generate a random replacement.
CREDENTIALS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# Must be exactly false in production.
ZARINPAL_SANDBOX=true
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3002

UPLOAD_DIR=./uploads
RETURN_DIR=./uploads-returns

# Leave empty when Fiber receives traffic directly. Behind a proxy, list only
# the proxy IPs/CIDRs allowed to supply X-Forwarded-For, comma-separated.
TRUSTED_PROXIES=

# Optional. Integration tests self-skip when this is absent. The database name
# must contain "test" because the test harness resets its public schema.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/z_games_test
